# ---- Database (Aiven MySQL) ----
DB_HOST=
DB_PORT=20480
DB_USER=
DB_PASSWORD=
DB_NAME=

# ---- Security (REQUIRED in production) ----
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
AUTH_TOKEN_MAX_AGE=604800
# Production frontend + http://localhost:5173 are always allowed (see app.py).
# Optional extra comma-separated origins, e.g. a Vercel preview deployment:
CORS_ORIGINS=

# ---- Gemini (chat + embeddings) ----
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIMS=768

# ---- AI tuning / cost control ----
AI_MAX_OUTPUT_TOKENS=700
AI_RATE_LIMIT_PER_MIN=20
AI_INDEX_TTL=600
AI_MIN_SIMILARITY=0.45

# ---- Optional: Upstash Redis (short-term chat memory, rate limits, caches) ----
# Upstash console -> your database -> "REST API" section -> UPSTASH_REDIS_REST_URL / _TOKEN.
# The URL must start with https:// (NOT the redis:// connection string).
# Leave empty to use the built-in in-memory fallback. Check: GET /api/ai/health -> "redis"
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=
